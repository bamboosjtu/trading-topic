  - elementId: bar-3t
    elementType: text
    bounds: [65, 270, 168, 34]
    content: {fontSize: 14, fontFamily: "Microsoft YaHei", bold: true, color: "#FFFFFF", align: [left, middle], text: "供配电 / 液冷"}
  - elementId: bar-4
    elementType: shape
