# 国内镜像配置（中国大陆地区 Electron 安装必需）
# 淘宝 NPM 镜像（npmmirror.com 是 registry.npm.taobao.org 的替代域名）
registry=https://registry.npmmirror.com/

# Electron 二进制下载镜像（默认从 github.com 下载，国内常超时）
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# 同步环境变量（npm install 时 electron 包会读取这些变量）
# 注意：electron 镜像需要使用完整路径格式（带版本占位符）
# https://github.com/electron/electron/blob/main/docs/tutorial/paths.md
ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/

# 严格引擎检查，避免 node 版本不匹配
engine-strict=true

# 提高 npm 在 Windows 上的网络稳定性
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000
